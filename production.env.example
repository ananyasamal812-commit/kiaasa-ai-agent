# Copy to production.env. Keep real keys private.
SITE_DOMAIN=assistant.your-domain.com
APP_ENV=production
ALLOWED_HOSTS=assistant.your-domain.com,127.0.0.1,localhost,app
ALLOWED_ORIGINS=https://assistant.your-domain.com
SESSION_SECRET=replace-with-at-least-32-random-characters
LLM_PROVIDER=groq
GROQ_ENABLED=true
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OPENAI_ENABLED=false
CATALOGUE_AUTO_SYNC=true
CATALOGUE_SYNC_INTERVAL_SECONDS=21600
TRACKING_REQUIRE_VERIFICATION=true
# Only the merchant's verified-order service may issue proof tokens using this secret.
TRACKING_VERIFICATION_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_TOKEN=
SHIPROCKET_CHANNEL_ID=
