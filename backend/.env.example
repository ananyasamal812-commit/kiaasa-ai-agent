GEMINI_API_KEY=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Alternatively, supply a valid bearer token.
SHIPROCKET_TOKEN=
# Optional: scope website order references to the Kiaasa sales channel.
SHIPROCKET_CHANNEL_ID=

# Refresh the public website catalogue while the backend is running.
CATALOGUE_AUTO_SYNC=true
# Six hours; minimum supported setting is 300 seconds.
CATALOGUE_SYNC_INTERVAL_SECONDS=21600

# OpenAI natural-language shopping interpretation (server-side only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_ENABLED=true

# Language provider: groq, openai, or local. Groq does not use the OpenAI API key.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ENABLED=true
